public class TechTpHelper : MonoBehaviour
{
    private Tank cachedTank;
    private float tankRefreshTimer;
    private const float TankRefreshInterval = 10f;

    void Start()
    {
        RefreshTank();
    }

    void Update()
    {
        // 10秒ごとにTankを再取得
        tankRefreshTimer += Time.deltaTime;
        if (tankRefreshTimer >= TankRefreshInterval)
        {
            tankRefreshTimer = 0f;
            RefreshTank();
        }

        // Shift+T でテレポート実行
        if (Input.GetKey(KeyCode.LeftShift) && Input.GetKeyDown(KeyCode.T))
        {
            TeleportToMouse();
        }

        // 左クリック検知
        if (Input.GetMouseButtonDown(0))
        {
            Debug.Log("Left click detected at: " + Input.mousePosition);
        }
    }

    void RefreshTank()
    {
        var myPlayer = Singleton.Manager<ManNetwork>.inst.MyPlayer;
        if (myPlayer != null && myPlayer.CurTech != null && myPlayer.CurTech.tech != null)
        {
            cachedTank = myPlayer.CurTech.tech;
            Debug.Log("Tank refreshed: " + cachedTank.name);
        }
    }

    void TeleportToMouse()
    {
        if (cachedTank == null)
        {
            Debug.Log("No cached Tank - cannot teleport");
            return;
        }

        Camera cam = Camera.main;
        if (cam == null) return;

        Ray ray = cam.ScreenPointToRay(Input.mousePosition);
        RaycastHit hit;
        if (Physics.Raycast(ray, out hit, 2000f))
        {
            cachedTank.trans.position = hit.point + Vector3.up * 3f;
            Debug.Log("Teleported to: " + hit.point);
        }
    }
}
